PORT=4000

# MySQL (docker compose mapeia o contentor para a porta 3308 do host)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=erprms
MYSQL_PASSWORD=erprms
MYSQL_DATABASE=erprms

# Usado só para migrate/reset (criar triggers)
MYSQL_ROOT_PASSWORD=root

# Alternativa: Unix socket (descomenta e comenta MYSQL_HOST/PORT)
# MYSQL_SOCKET=/caminho/para/mysql.sock
